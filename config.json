{
  "webdriver": {
    "headless": true,
    "implicit_wait": 5,
    "page_load_timeout": 30,
    "window_width": 1920,
    "window_height": 1080
  },
  "automation": {
    "max_retries": 3,
    "retry_delay": 2,
    "form_fill_delay": 0.5,
    "click_delay": 1.0,
    "page_load_wait": 2
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file_path": null
  }
}

